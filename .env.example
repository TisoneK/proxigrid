# Proxigrid environment — copy to .env for local dev, set these in Vercel too.

# --- Database (required) ---
# Postgres connection string. Locally: a local Postgres or a Neon/Vercel Postgres
# dev branch. On Vercel: added automatically by the Vercel Postgres / Neon
# integration. (SQLite is no longer supported — Vercel's filesystem is ephemeral.)
DATABASE_URL="postgresql://user:password@host:5432/proxigrid?sslmode=require"

# --- Vercel Cron (required on Vercel) ---
# Random secret; Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`
# to /api/cron/tick, which runs the signal scan + automation sweep each tick.
CRON_SECRET="change-me-to-a-long-random-string"

# --- Scanner tuning (optional) ---
SIGNAL_SCAN_SYMBOLS="BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT"
SIGNAL_SCAN_TIMEFRAME="1h"
SIGNAL_RETENTION_DAYS="7"

# --- Exchanges (optional) ---
# Turn on the Coinbase market-data adapter (browse-only). Default off.
# COINBASE_ENABLED="true"

# --- Binance trading (optional; only if you connect a real/testnet account) ---
# BINANCE_API_KEY=""
# BINANCE_API_SECRET=""
# BINANCE_PRIVATE_KEY=""     # Ed25519 PEM (preferred); \n-escaped is fine
# BINANCE_PAPER="true"        # testnet by default
# ENABLE_LIVE_TRADING="false" # place_order actions stay dry-run unless true

# --- Self-hosted only (NOT on Vercel) ---
# On an always-on server you can run the workers in-process instead of via cron:
# ENABLE_SIGNAL_SCANNER="true"
# ENABLE_AUTOMATION_WORKER="true"
